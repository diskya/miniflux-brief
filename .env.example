# Copy to .env for Docker Compose, or to /etc/feedsum.conf (mode 0640) for the
# systemd unit. Every variable is documented in README.md.

# --- Miniflux -----------------------------------------------------------------
# Where feedsum reads entry URLs and writes briefs back.
#   Miniflux on this host, feedsum in Compose : http://host.docker.internal:8080
#   Miniflux in another Compose project       : http://miniflux:8080  (join its network)
#   both outside Docker                       : http://127.0.0.1:8080
MINIFLUX_URL=http://host.docker.internal:8080
# Settings -> API Keys -> create one named feedsum.
MINIFLUX_API_TOKEN=
# Settings -> Integrations -> Webhook. Must match exactly; generate with
#   openssl rand -hex 32
FEEDSUM_WEBHOOK_SECRET=
# Independent credential for the Brief UI API. This is not the Miniflux API
# token and must not be reused as one. Generate separately with:
#   openssl rand -hex 32
FEEDSUM_UI_TOKEN=

# --- Articles: any OpenAI-compatible endpoint ---------------------------------
# OpenAI          https://api.openai.com/v1
# DashScope       https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenRouter      https://openrouter.ai/api/v1
# Ollama (local)  http://host.docker.internal:11434/v1   (any key will do)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
FEEDSUM_TEXT_MODEL=gpt-4o-mini

# --- Video: Gemini watches the video itself -----------------------------------
# Optional. Without it, article entries are unaffected and video entries fail
# with a clear message. Several keys may be listed, comma-separated: each has
# its own quota, so exhausting one only moves the work to the next.
GEMINI_API_KEY=
# Must be a model that accepts video input.
FEEDSUM_GEMINI_MODEL=gemini-3.7-flash

# --- Behaviour ----------------------------------------------------------------
# 0 leaves entries alone; briefs are then only visible through the Brief button.
FEEDSUM_WRITE_BACK=1
# Restrict automatic briefing to these feed ids. Empty means every feed — worth
# setting if you follow a high-volume feed you would not want to pay to brief.
FEEDSUM_FEED_IDS=

# Host port for feedsum. Keep 8012 normally; isolated tests use another port.
FEEDSUM_PORT=8012

# That is everything. Timeouts, retry delays and concurrency are fixed values in
# feedsum/config.py rather than settings, because no deployment needs to differ.

# Set by docker-compose.yml; only needed when running outside Compose.
#FEEDSUM_READER_URL=http://127.0.0.1:8010
#FEEDSUM_DB=/var/lib/feedsum/feedsum.db
