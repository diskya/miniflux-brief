# Mounting feedsum on the Miniflux origin, for Caddy.
#
# Miniflux's Content-Security-Policy is `connect-src 'self'`, so the custom JS
# that draws the Brief button can only call the origin Miniflux is served from.
# Putting feedsum under /_summary on that same origin is what makes the button
# work. A Miniflux session cookie does not authenticate a different upstream;
# feedsum therefore also requires X-Feedsum-UI-Token on every /v1 request.

feeds.example.com {
    # If you also put a proxy authentication layer in front of Miniflux, import
    # it before both handlers. It is defense in depth, not a replacement for
    # the feedsum UI token.
    # import authed

    handle /_summary/* {
        uri strip_prefix /_summary
        reverse_proxy 127.0.0.1:8012
    }

    reverse_proxy 127.0.0.1:8080
}
